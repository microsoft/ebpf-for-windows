<!-- This is an aggregator "Utility" project that builds only the binaries required to run the
     driver validation tests. It is intended to be built by the internal release pipeline via:
       msbuild ebpf-for-windows.sln /t:tools\driver-test /p:Configuration=NativeOnlyRelease /p:Platform=x64
     Only driver tests are required for release validation, so this target avoids building the
     unit tests, fuzzers, and dev tools that make up the rest of the solution. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(SolutionDir)wdk.props" />
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{2549DCD5-3190-4E46-A5AB-42E77D5383DE}</ProjectGuid>
    <RootNamespace>drivertest</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(EbpfPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(EbpfPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='NativeOnlyDebug'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(EbpfPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='NativeOnlyRelease'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(EbpfPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemGroup>
    <!-- Sample extension driver (test hook/helper provider). -->
    <ProjectReference Include="..\..\undocked\tests\sample\ext\drv\sample_ext.vcxproj">
      <Project>{c8d46543-5ae5-4e66-b9ce-8b84588b1c9e}</Project>
    </ProjectReference>
    <!-- Sample eBPF programs compiled as native drivers. -->
    <ProjectReference Include="..\..\tests\sample\sample.vcxproj">
      <Project>{b4ad72e3-754e-40ca-9cea-d3f2c9170e51}</Project>
    </ProjectReference>
    <!-- Driver validation test binaries. -->
    <ProjectReference Include="..\..\tests\api_test\api_test.vcxproj">
      <Project>{12161211-5463-4aa9-9b6e-552552b475dc}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\socket\socket_tests.vcxproj">
      <Project>{eed9dac6-8b98-4c33-969a-e8cede8e985e}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\connect_redirect\connect_redirect_tests.vcxproj">
      <Project>{02a1913f-7ff5-4c20-b230-2240b4edec10}</Project>
    </ProjectReference>
    <!-- Helper listener process launched by scripts\vm_run_tests.psm1
         (Invoke-ConnectRedirectTestHelper) before connect_redirect_tests.exe runs.
         Without it the connect redirect tests fail with
         "This command cannot be run due to the error: The system cannot find the file specified." -->
    <ProjectReference Include="..\..\tests\tcp_udp_listener\tcp_udp_listener.vcxproj">
      <Project>{64ad121f-b4d4-4b38-a370-ddd4fea6707e}</Project>
    </ProjectReference>
    <!-- Additional driver test binaries invoked from scripts\run_driver_tests.psm1
         on the driver-test VMs. These must be built for driver validation to run. -->
    <ProjectReference Include="..\..\tests\bpftool_tests\bpftool_tests.vcxproj">
      <Project>{8b5b061b-3170-4d1b-8c5b-e86b890c14b8}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\sample\ext\app\sample_ext_app.vcxproj">
      <Project>{6D365515-DE92-4CEB-AB3D-5608719A8886}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\performance\performance.vcxproj">
      <Project>{724eb55a-ccfc-4662-92e3-b664cda365e7}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\stress\restart_test_controller\ebpf_restart_test_controller.vcxproj">
      <Project>{E3F9A8B4-5678-4ABC-9DEF-123456789ABC}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\stress\restart_test_helper\ebpf_restart_test_helper.vcxproj">
      <Project>{25725C06-3335-4CBA-AB16-6FE5E51BE842}</Project>
    </ProjectReference>
    <ProjectReference Include="..\..\tests\stress\km\ebpf_stress_tests_km.vcxproj">
      <Project>{4F082524-9496-44FA-8CBA-4BC0BDC62568}</Project>
    </ProjectReference>
    <!-- eBPF MSI installer. The driver validation setup (scripts\install_ebpf.psm1)
         installs the eBPF runtime (ebpfcore.sys, netebpfext.sys, ebpfsvc.exe,
         ebpfapi.dll, and their dependencies) from ebpf-for-windows.msi, so the
         installer must be built for the driver tests to run. -->
    <ProjectReference Include="..\..\installer\ebpf-for-windows.wixproj">
      <Project>{fe9b26cd-e885-4881-90d7-a096131c5c4a}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Fail the build immediately if a file the driver validation tests launch at run time
       is missing from this target's project closure. Without this check a missing binary
       only surfaces ~45 minutes later as an opaque test failure on the test machines. -->
  <Target Name="VerifyDriverTestClosure" AfterTargets="Build">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SolutionDir)scripts\check_driver_test_closure.ps1&quot; -BuildPath &quot;$(OutDir.TrimEnd('\'))&quot;" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
