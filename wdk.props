<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">
  <PropertyGroup>
    <_EbpfUseWdkPackageReferences>true</_EbpfUseWdkPackageReferences>
    <HostPlatform Condition="'$(HostPlatform)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</HostPlatform>
    <!-- Target/toolset/WDK selection. All three use the same '>= 18.0' vs '< 18.0' split so we
         never end up partially configured (e.g. WDKVersion set but toolset empty) on an
         unexpected toolset version. Each property can be overridden from the command line.

         These gate on $(MSBuildAssemblyVersion), which is always defined and evaluates to the
         MSBuild major version ("17.0" for VS 2022, "18.0" for VS 2026). Two alternatives do NOT
         work here: $(VisualStudioVersion) is only guaranteed when the build is driven by VS or a
         Developer Command Prompt, and $(MSBuildToolsVersion) evaluates to the string "Current" on
         both VS 2022 and VS 2026, so comparing it against '18.0' never distinguishes the two (and
         can raise MSB4086 on a numeric comparison). Selecting the wrong branch pairs the VS 2022
         WDK with the VS 2026 toolset, which fails with MSB4062 while loading
         Microsoft.DriverKit.Build.Tasks.18.0.dll, an assembly the 26100 package does not ship. -->
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">10.0.28000.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- WDK NuGet package version: VS 2026 (MSBuild 18) requires 10.0.28000.2526;
         VS 2022 (MSBuild 17) uses 10.0.26100.6584. -->
    <WDKVersion Condition="'$(WDKVersion)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">10.0.28000.2526</WDKVersion>
    <WDKVersion Condition="'$(WDKVersion)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">10.0.26100.6584</WDKVersion>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfWdkTargetPlatform)' != ''">$(_EbpfWdkTargetPlatform)</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == '' and '$(Platform)' != ''">$(Platform)</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == ''">x64</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform>$(_EbpfTargetPackagePlatform.ToLowerInvariant())</_EbpfTargetPackagePlatform>
    <_EbpfTargetPackagePlatform Condition="'$(_EbpfTargetPackagePlatform)' == 'win32'">x86</_EbpfTargetPackagePlatform>
    <_EbpfHostPackagePlatform>$(HostPlatform.ToLowerInvariant())</_EbpfHostPackagePlatform>
    <_EbpfHostPackagePlatform Condition="'$(_EbpfHostPackagePlatform)' == 'amd64'">x64</_EbpfHostPackagePlatform>
    <_EbpfHostPackagePlatform Condition="'$(_EbpfHostPackagePlatform)' == 'win32'">x86</_EbpfHostPackagePlatform>
    <TargetFramework Condition="'$(TargetFramework)' == ''">native</TargetFramework>
    <_NuGetTargetFallbackMoniker Condition="'$(_NuGetTargetFallbackMoniker)' == ''">native,Version=v0.0</_NuGetTargetFallbackMoniker>
    <RestorePackages Condition="'$(RestorePackages)' == ''">true</RestorePackages>
    <RestoreProjectStyle Condition="'$(RestoreProjectStyle)' == ''">PackageReference</RestoreProjectStyle>
    <MSBuildProjectExtensionsPath Condition="'$(MSBuildProjectExtensionsPath)' == ''">$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <!-- Default platform toolset for user-mode projects. Kernel-mode projects override this
         with WindowsKernelModeDriver10.0 in their vcxproj Configuration PropertyGroups. -->
    <EbpfPlatformToolset Condition="'$(EbpfPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">v145</EbpfPlatformToolset>
    <EbpfPlatformToolset Condition="'$(EbpfPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">v143</EbpfPlatformToolset>
    <!-- Platform toolset consumed by the ebpf-extension-common submodule. Its Directory.Build.props
         imports "$(SolutionDir)wdk.props", which resolves to THIS file when the submodule is built as
         part of the eBPF-for-Windows solution, so the toolset variable its vcxproj files reference
         ($(EbpfExtPlatformToolset)) must be defined here. Without it the toolset is empty and MSBuild
         falls back to v100, causing MSB8020. (usersim is self-contained: its projects import their own
         wdk.props via a relative path, so no equivalent definition is needed here.) -->
    <EbpfExtPlatformToolset Condition="'$(EbpfExtPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &gt;= '18.0'">v145</EbpfExtPlatformToolset>
    <EbpfExtPlatformToolset Condition="'$(EbpfExtPlatformToolset)' == '' and '$(MSBuildAssemblyVersion)' &lt; '18.0'">v143</EbpfExtPlatformToolset>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.CPP"
                      Version="[$(WDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.$(_EbpfTargetPackagePlatform)"
                      Version="[$(WDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.WDK.$(_EbpfTargetPackagePlatform)"
                      Version="[$(WDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.$(_EbpfHostPackagePlatform)"
                      Version="[$(WDKVersion)]"
                      PrivateAssets="all"
                      Condition="'$(_EbpfHostPackagePlatform)' != '$(_EbpfTargetPackagePlatform)'" />
    <PackageReference Include="Microsoft.Windows.WDK.$(_EbpfHostPackagePlatform)"
                      Version="[$(WDKVersion)]"
                      PrivateAssets="all"
                      Condition="'$(_EbpfHostPackagePlatform)' != '$(_EbpfTargetPackagePlatform)'" />
  </ItemGroup>
  <!-- Log the WDK version -->
  <Target Name="LogWDKVersion" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="Using WDK version $(WDKVersion)" />
    <Message Importance="high" Text="Using Windows target platform version $(WindowsTargetPlatformVersion)" />
    <Message Importance="high" Text="Using WDK content root $(WdkContentRoot)" />
    <Message Importance="high" Text="Using host platform $(HostPlatform)" />
    <Message Importance="high" Text="Using target platform $(Platform)" />
    <Message Importance="high" Text="PROCESSOR_ARCHITECTURE is $(PROCESSOR_ARCHITECTURE)" />
    <Message Importance="high" Text="PROCESSOR_ARCHITEW6432 is $(PROCESSOR_ARCHITEW6432)" />
  </Target>
  <Target Name="EnsureWdkPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_EbpfNormalizedNuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_EbpfNormalizedNuGetPackageRoot>
      <_EbpfExpectedWdkContentRoot>$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(_EbpfNormalizedNuGetPackageRoot)microsoft.windows.wdk.$(_EbpfTargetPackagePlatform)\$(WDKVersion)\c'))'))</_EbpfExpectedWdkContentRoot>
      <_EbpfActualWdkContentRoot Condition="'$(WdkContentRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$([MSBuild]::NormalizePath('$(WdkContentRoot)'))'))</_EbpfActualWdkContentRoot>
      <_EbpfExpectedWdkInclude>$(WdkContentRoot)\Include\$(WindowsTargetPlatformVersion)\km</_EbpfExpectedWdkInclude>
      <_EbpfExpectedSdkInclude>$(WindowsSdkDir)\Include\$(WindowsTargetPlatformVersion)\shared</_EbpfExpectedSdkInclude>
      <_EbpfMissingPackageError>The required WDK/SDK package assets are missing or do not match the selected Visual Studio version. Restore the solution or run .\scripts\initialize_ebpf_repo.ps1 with the matching -Architecture and -VisualStudioVersion. The missing path is {0}.</_EbpfMissingPackageError>
    </PropertyGroup>
    <Error Condition="'$(_EbpfActualWdkContentRoot)' != '$(_EbpfExpectedWdkContentRoot)'" Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedWdkContentRoot)'))" />
    <Error Condition="'$(WdkContentRoot)' == '' or !Exists('$(_EbpfExpectedWdkInclude)')" Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedWdkInclude)'))" />
    <Error Condition="'$(WindowsSdkDir)' == '' or !Exists('$(_EbpfExpectedSdkInclude)')" Text="$([System.String]::Format('$(_EbpfMissingPackageError)', '$(_EbpfExpectedSdkInclude)'))" />
  </Target>
</Project>
