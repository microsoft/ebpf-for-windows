SPDX-License-Identifier: MIT
-->
<!-- Product version must remain the same for the life of the product. Do not change it. -->
<?define ProductVersion="022C44B5-8969-4B75-8DB0-73F98B1BD7DC"?>
<?define UpgradeCode="B6BCACB1-C872-4159-ABCB-43A50668056C"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:ui="http://schemas.microsoft.com/wix/UIExtension" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
	<Product Id="$(var.ProductVersion)" Name="eBPF for Windows" Language="1033" Version="$(var.EbpfVersionNoModifier)" Manufacturer="Microsoft" UpgradeCode="$(var.UpgradeCode)">
		<!-- Platform should be $(var.Platform) but the current installer doesn't support ARM64. Fortunately ARM64 can emulate x64, so setting it to x64 works. -->
		<Package Description="eBPF for Windows" InstallerVersion="301" Compressed="yes" InstallScope="perMachine" Manufacturer="Microsoft" Platform="x64"/>
		<MajorUpgrade AllowSameVersionUpgrades="yes"
					  Disallow="yes" DisallowUpgradeErrorMessage="An older version of [ProductName] is already installed. Please remove it first."
					  AllowDowngrades="no" DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please remove it first." Schedule="afterInstallFinalize" />
		<MediaTemplate EmbedCab="yes" />

		<!-- Define global properties -->
		<PropertyRef Id="WIX_ACCOUNT_LOCALSERVICE" />
		<Property Id="ARPCONTACT" Value="opencode@microsoft.com" />
		<Property Id="FORCE" Secure="yes" />
		<Property Id="EXISTING_EBPFCORE">
			<RegistrySearch Id="FindExistingEbpfCore" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\eBPFCore" Name="ImagePath" Type="raw" Win64="yes" />
		</Property>
		<Property Id="EXISTING_NETEBPFEXT">
			<RegistrySearch Id="FindExistingNetEbpfExt" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\NetEbpfExt" Name="ImagePath" Type="raw" Win64="yes" />
		</Property>
		<Property Id="EXISTING_EBPFSVC">
			<RegistrySearch Id="FindExistingEbpfSvc" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\eBPFSvc" Name="ImagePath" Type="raw" Win64="yes" />
		</Property>
		<Property Id="INSTALLFOLDER" Secure="yes">
			<RegistrySearch Id="FindInstallLocation" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[WIX_UPGRADE_DETECTED]" Name="InstallLocation" Type="raw" Win64="yes" />
		</Property>
		<Condition Message="eBPFCore is already installed. Run this installer with FORCE=1 to replace the existing eBPF services.">
			Installed OR NOT EXISTING_EBPFCORE OR FORCE = "1"
		</Condition>
		<Condition Message="An existing NetEbpfExt registration was detected without an eBPFCore registration. Repair or remove the incomplete eBPF installation before continuing.">
			Installed OR NOT EXISTING_NETEBPFEXT OR EXISTING_EBPFCORE
		</Condition>

		<!-- Define the Product features and installation steps -->
		<Feature Id="ProductFeature" Title="eBPF for Windows Installer" ConfigurableDirectory="INSTALLFOLDER" Display="expand" Level="1" Absent="disallow" AllowAdvertise="no" InstallDefault="local" TypicalDefault="install" >
			<Feature Id="eBPF_Runtime_Components" Level="1" Title="Runtime Components" Absent="disallow" Display="expand" AllowAdvertise="no" >
				<ComponentGroupRef Id="eBPF_Runtime_Components" />
				<ComponentGroupRef Id="eBPFCore_Driver" />
				<ComponentGroupRef Id="NetEbpfExt_Driver" />
				<ComponentGroupRef Id="eBPF_Service" />
			</Feature>
		</Feature>

		<InstallExecuteSequence>
			<!-- Forced installs back up running state before stopping services in the custom chain. -->
			<StopServices>VersionNT AND NOT (NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1")</StopServices>

			<!--Rollback sequence-->
			<Custom Action="eBPF_netsh_helper_uninstall_rollback" Before="eBPF_netsh_helper_install">NOT Installed</Custom>

			<!-- Register stop undo last so rollback stops drivers before restoring or deleting their registrations. -->
			<Custom Action="eBPFCore_Driver_stop_rollback" After="Force_eBPFCore_Driver_configure">NOT Installed AND (NOT EXISTING_EBPFCORE OR FORCE = "1")</Custom>
			<Custom Action="eBPFCore_Driver_uninstall_rollback" Before="eBPFCore_Driver_install">NOT Installed AND NOT EXISTING_EBPFCORE</Custom>

			<Custom Action="NetEbpfExt_Driver_stop_rollback" After="Force_NetEbpfExt_Driver_configure">NOT Installed AND (NOT EXISTING_NETEBPFEXT OR FORCE = "1")</Custom>
			<Custom Action="NetEbpfExt_Driver_uninstall_rollback" Before="NetEbpfExt_Driver_install">NOT Installed AND NOT EXISTING_NETEBPFEXT</Custom>
			<Custom Action="Force_eBPFSvc_stop_rollback" Before="Force_eBPFSvc_configure">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="eBPFSvc_uninstall_rollback" Before="Force_eBPFSvc_configure">NOT Installed AND NOT EXISTING_EBPFSVC</Custom>
			<Custom Action="Force_eBPF_binaries_uninstall_rollback" Before="Force_eBPF_binaries_uninstall_restore">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_rollback_HKCU" After="Force_eBPF_store_uninstall_prepare_HKCU">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_rollback_HKLM" After="Force_eBPF_store_uninstall_prepare_HKLM">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>

			<!--Install sequence-->
			<Custom Action="Force_eBPF_services_rollback" After="InstallFiles">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_services_backup" After="Force_eBPF_services_rollback">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_NetEbpfExt_Driver_stop" After="Force_eBPF_services_backup">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPFSvc_stop" After="Force_NetEbpfExt_Driver_stop">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPFCore_Driver_stop" After="Force_eBPFSvc_stop">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_binaries_restore" After="Force_eBPFCore_Driver_stop">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_binaries_hardlink" After="Force_eBPF_binaries_restore">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_binaries_cleanup" After="Force_eBPF_binaries_hardlink">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_store_rollback_HKLM" After="Force_eBPF_binaries_cleanup">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_store_backup_HKLM" After="Force_eBPF_store_rollback_HKLM">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_store_rollback_HKCU" After="Force_eBPF_store_backup_HKLM">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_store_backup_HKCU" After="Force_eBPF_store_rollback_HKCU">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_store_commit" After="Setup_eBPF_store_HKCU">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_eBPF_services_commit" After="Force_eBPF_store_commit">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>

			<Custom Action="Clear_eBPF_store_HKLM" After="Force_eBPF_store_backup_HKCU">NOT Installed</Custom>
			<Custom Action="Setup_eBPF_store_HKLM" After="Clear_eBPF_store_HKLM">NOT Installed</Custom>
			<Custom Action="Clear_eBPF_store_HKCU" After="Setup_eBPF_store_HKLM">NOT Installed</Custom>
			<Custom Action="Setup_eBPF_store_HKCU" After="Clear_eBPF_store_HKCU">NOT Installed</Custom>

			<Custom Action="eBPF_netsh_helper_install" After="Setup_eBPF_store_HKCU">NOT Installed</Custom>

			<Custom Action="eBPFCore_Driver_install" After="Setup_eBPF_store_HKCU">NOT Installed AND NOT EXISTING_EBPFCORE</Custom>
			<Custom Action="Force_eBPFCore_Driver_configure" After="eBPFCore_Driver_install">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="eBPFCore_Driver_start" After="eBPFCore_Driver_stop_rollback">NOT Installed</Custom>

			<Custom Action="NetEbpfExt_Driver_install" After="Setup_eBPF_store_HKCU">NOT Installed AND NOT EXISTING_NETEBPFEXT AND NOT (EXISTING_EBPFCORE AND FORCE = "1")</Custom>
			<Custom Action="Force_NetEbpfExt_Driver_install" After="NetEbpfExt_Driver_install">NOT Installed AND NOT EXISTING_NETEBPFEXT AND EXISTING_EBPFCORE AND FORCE = "1"</Custom>
			<Custom Action="Force_NetEbpfExt_Driver_configure" After="Force_NetEbpfExt_Driver_install">NOT Installed AND EXISTING_NETEBPFEXT AND FORCE = "1"</Custom>
			<Custom Action="NetEbpfExt_Driver_start" After="NetEbpfExt_Driver_stop_rollback">NOT Installed</Custom>
			<Custom Action="Force_eBPFSvc_configure" After="InstallServices">NOT Installed</Custom>

			<!--Uninstall sequence-->
			<Custom Action="Force_eBPF_services_uninstall_prepare" After="InstallInitialize">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_services_uninstall_rollback" After="Force_eBPF_services_uninstall_prepare">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_prepare_HKLM" After="Force_eBPF_services_uninstall_rollback">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_prepare_HKCU" After="Force_eBPF_store_uninstall_rollback_HKLM">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="eBPF_netsh_helper_uninstall" After="Force_eBPF_store_uninstall_rollback_HKCU">REMOVE="ALL"</Custom>

			<Custom Action="NetEbpfExt_Driver_stop" After="eBPF_netsh_helper_uninstall">REMOVE="ALL"</Custom>
			<Custom Action="eBPFCore_Driver_stop" After="NetEbpfExt_Driver_stop">REMOVE="ALL"</Custom>
			<Custom Action="Force_eBPF_services_uninstall_remove" After="eBPFCore_Driver_stop">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>

			<Custom Action="Force_eBPF_store_restore_HKLM" Before="Force_eBPF_store_restore_HKCU">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_restore_HKCU" Before="Force_eBPF_binaries_uninstall_restore">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_binaries_uninstall_restore" Before="Force_eBPF_services_uninstall_restore">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_services_uninstall_restore" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_commit_HKLM" Before="Force_eBPF_store_uninstall_commit_HKCU">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_store_uninstall_commit_HKCU" Before="Force_eBPF_services_uninstall_commit">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="Force_eBPF_services_uninstall_commit" Before="InstallFinalize">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
			<Custom Action="eBPFCore_Driver_uninstall_flush" After="InstallFinalize">REMOVE="ALL"</Custom>
		</InstallExecuteSequence>

		<!-- Define the UI style & behavior -->
		<UIRef Id="WixUI_FeatureTree" />
		<WixVariable Id="WixUILicenseRtf" Value="$(var.SolutionDir)installer\LICENSE.rtf" />
		<WixVariable Id="WixUIBannerBmp" Value="res\eBPFBanner_493x58.bmp"/>
		<WixVariable Id="WixUIDialogBmp" Value="res\eBPFDialog_493x312.bmp"/>
		<CustomAction Id="SetWixInstallLocation" Property="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" />
		<InstallUISequence>
			<Custom Action="SetWixInstallLocation" After="CostFinalize" />
		</InstallUISequence>
		<UI />
	</Product>

	<!-- Define installation directories -->
	<Fragment>
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFiles64Folder">
				<Directory Id="INSTALLFOLDER" Name="ebpf-for-windows">
					<Directory Id="dir_JIT" Name="JIT" />
					<Directory Id="dir_drivers" Name="drivers"/>
				</Directory>
			</Directory>
		</Directory>
	</Fragment>

	<!-- Define the product's <Runtime> components -->
	<Fragment>
		<ComponentGroup Id="eBPF_Runtime_Components" Directory="INSTALLFOLDER">
			<Component Id ="eBpfPATH" Guid="{C062B980-4B93-4FC7-A4F9-A751C2B419FD}" KeyPath="yes">
				<Environment Id="eBpfPATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" Separator=";" />
			</Component>
			<Component Id="LICENSE" Guid="{AF22EAE5-7D8D-4F22-BB64-6B6A079A2947}">
				<File Id="LICENSE.txt" Name="LICENSE.txt" DiskId="1" KeyPath="yes" Source="$(var.SolutionDir)LICENSE.txt" />
			</Component>
			<Component Id="FORCE_EBPF_STACK.PS1" Guid="{92C5A39B-CF29-4DC4-AC49-32F449CFF561}">
				<File Id="FORCE_EBPF_STACK.PS1" Name="ForceEbpfStack.ps1" DiskId="1" KeyPath="yes" Source="$(var.SolutionDir)installer\ForceEbpfStack.ps1" />
			</Component>
			<Component Id="BPF2C.EXE" DiskId="1" Guid="{BD23322B-91C3-4848-96E0-04E3745411E1}">
				<File Id="BPF2C.EXE" Name="bpf2c.exe" KeyPath="yes" Source="$(var.bpf2c.TargetDir)bpf2c.exe" />
			</Component>
			<Component Id="BPF2C.PDB" DiskId="1" Guid="{6DEC471C-F27D-431C-A0E0-6F46CA472BAC}">
				<File Id="BPF2C.PDB" Name="bpf2c.pdb" KeyPath="yes" Source="$(var.bpf2c.TargetDir)bpf2c.pdb" />
			</Component>
			<Component Id="EBPF_ALL.GUID" DiskId="1" Guid="{F3C808AC-A63B-4A29-B110-00B5A903F3C9}">
				<File Id="EBPF_ALL.GUID" Name="ebpf-all.guid" KeyPath="yes" Source="$(var.SolutionDir)\scripts\ebpf-all.guid" />
			</Component>
			<Component Id="BPFTOOL.EXE" DiskId="1" Guid="{E168EB1A-35F6-47E3-B977-B16DF7DFBDB0}">
				<File Id="BPFTOOL.EXE" Name="bpftool.exe" KeyPath="yes" Source="$(var.bpftool.TargetDir)bpftool.exe" />
			</Component>
			<Component Id="BPFTOOL.PDB" DiskId="1" Guid="{D2A6D747-A52C-43B9-A684-FF05A0DCE166}">
				<File Id="BPFTOOL.PDB" Name="bpftool.pdb" KeyPath="yes" Source="$(var.bpftool.TargetDir)bpftool.pdb" />
			</Component>
			<Component Id="EBPFAPI.DLL" DiskId="1" Guid="{C44E4B08-901E-4B71-8FD1-F0B3D11D063F}">
				<File Id="EBPFAPI.DLL" Name="EbpfApi.dll" KeyPath="yes" Source="$(var.EbpfApi.TargetDir)EbpfApi.dll" />
			</Component>
			<Component Id="EBPFAPI.PDB" DiskId="1" Guid="{6912E957-E682-41CB-9C53-1D0B886528F7}">
				<File Id="EBPFAPI.PDB" Name="EbpfApi.pdb" KeyPath="yes" Source="$(var.EbpfApi.TargetDir)EbpfApi.pdb" />
			</Component>
			<Component Id="EBPF_PRINTK.GUID" DiskId="1" Guid="{77EB156D-046E-4BD6-8F57-CCA1DB031B0B}">
				<File Id="EBPF_PRINTK.GUID" Name="ebpf-printk.guid" KeyPath="yes" Source="$(var.SolutionDir)\scripts\ebpf-printk.guid" />
			</Component>
			<Component Id="EBPFFORWINDOWS.WPRP" DiskId="1" Guid="{4E4838D3-0C49-4FA2-B8EE-E484CC0E7FA9}">
				<File Id="EBPFFORWINDOWS.WPRP" Name="ebpfforwindows.wprp" KeyPath="yes" Source="$(var.SolutionDir)\scripts\ebpfforwindows.wprp" />
			</Component>
			<Component Id="EBPFNETSH.DLL" DiskId="1" Guid="{95928460-8560-448F-83C3-E9040BECCF5D}">
				<File Id="EBPFNETSH.DLL" Name="ebpfnetsh.dll" KeyPath="yes" Source="$(var.ebpfnetsh.TargetDir)ebpfnetsh.dll" />
			</Component>
			<Component Id="EBPFNETSH.PDB" DiskId="1" Guid="{D0FB50BF-8822-4197-B3CF-0476C357DBDD}">
				<File Id="EBPFNETSH.PDB" Name="ebpfnetsh.pdb" KeyPath="yes" Source="$(var.ebpfnetsh.TargetDir)ebpfnetsh.pdb" />
			</Component>
			<Component Id="EXPORT_PROGRAM_INFO.EXE" DiskId="1" Guid="{7AF9A30B-D7BF-4FD2-88C0-C2947ED55DCD}">
				<File Id="EXPORT_PROGRAM_INFO.EXE" Name="export_program_info.exe" KeyPath="yes" Source="$(var.export_program_info.TargetDir)export_program_info.exe" />
			</Component>
			<Component Id="EXPORT_PROGRAM_INFO.PDB" DiskId="1" Guid="{88356FE4-6247-4876-BA14-42EDA88CC5C7}">
				<File Id="EXPORT_PROGRAM_INFO.PDB" Name="export_program_info.pdb" KeyPath="yes" Source="$(var.export_program_info.TargetDir)export_program_info.pdb" />
			</Component>
		</ComponentGroup>

		<!--Clear/Setup the eBPF store-->
		<CustomAction Id="Clear_eBPF_store_HKLM" ExeCommand='"[#EXPORT_PROGRAM_INFO.EXE]" --clear' Directory="INSTALLFOLDER" Execute="deferred" Return="check" Impersonate="no"/>
		<CustomAction Id="Clear_eBPF_store_HKCU" ExeCommand='"[#EXPORT_PROGRAM_INFO.EXE]" --clear' Directory="INSTALLFOLDER" Execute="deferred" Return="check" Impersonate="yes"/>
		<SetProperty Id="Setup_eBPF_store_HKLM" Value='"[#EXPORT_PROGRAM_INFO.EXE]"' Before="Setup_eBPF_store_HKLM" Sequence="execute"/>
		<CustomAction Id="Setup_eBPF_store_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Setup_eBPF_store_HKCU" Value='"[#EXPORT_PROGRAM_INFO.EXE]"' Before="Setup_eBPF_store_HKCU" Sequence="execute"/>
		<CustomAction Id="Setup_eBPF_store_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_backup_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action BackupStore -Scope HKLM -OwnerProductCode &quot;[ProductCode]&quot; -OwnerUpgradeCode &quot;$(var.UpgradeCode)&quot;" Before="Force_eBPF_store_backup_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_backup_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_backup_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action BackupStore -Scope HKCU -OwnerProductCode &quot;[ProductCode]&quot; -OwnerUpgradeCode &quot;$(var.UpgradeCode)&quot;" Before="Force_eBPF_store_backup_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_backup_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_rollback_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackStore -Scope HKLM" Before="Force_eBPF_store_rollback_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_rollback_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_rollback_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackStore -Scope HKCU" Before="Force_eBPF_store_rollback_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_rollback_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_commit" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action CommitStore" Before="Force_eBPF_store_commit" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_commit" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_restore_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RestoreStore -Scope HKLM" Before="Force_eBPF_store_restore_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_restore_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_restore_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RestoreStore -Scope HKCU" Before="Force_eBPF_store_restore_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_restore_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_uninstall_prepare_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action PrepareRestoreStore -Scope HKLM" Before="Force_eBPF_store_uninstall_prepare_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_prepare_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_uninstall_prepare_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action PrepareRestoreStore -Scope HKCU" Before="Force_eBPF_store_uninstall_prepare_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_prepare_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_uninstall_rollback_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackRestoreStore -Scope HKLM" Before="Force_eBPF_store_uninstall_rollback_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_rollback_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_uninstall_rollback_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackRestoreStore -Scope HKCU" Before="Force_eBPF_store_uninstall_rollback_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_rollback_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="yes"/>
		<SetProperty Id="Force_eBPF_store_uninstall_commit_HKLM" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath '[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.json','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.pending','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.rollback.json','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.rollback.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.uninstall.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hklm.uninstall.json' -Force -ErrorAction SilentlyContinue&quot;" Before="Force_eBPF_store_uninstall_commit_HKLM" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_commit_HKLM" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="ignore" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_store_uninstall_commit_HKCU" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath '[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.json','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.pending','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.rollback.json','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.rollback.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.uninstall.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-store-hkcu.uninstall.json' -Force -ErrorAction SilentlyContinue&quot;" Before="Force_eBPF_store_uninstall_commit_HKCU" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_store_uninstall_commit_HKCU" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="ignore" Impersonate="yes"/>

		<!--Install/Uninstall the netsh helper-->
		<!--qtexec does not currently support a working directory (ref. https://github.com/wixtoolset/issues/issues/1265)-->
		<!--This workaround uses PowerShell to batch two commands, one to change the working directory, the other to execute the actual command from that directory.-->
		<SetProperty Id="eBPF_netsh_helper_install" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass &quot;cd '[INSTALLFOLDER]';&amp;netsh add helper ebpfnetsh.dll&quot;" Before="eBPF_netsh_helper_install" Sequence="execute"/>
		<CustomAction Id="eBPF_netsh_helper_install" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="eBPF_netsh_helper_uninstall" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass &quot;cd '[INSTALLFOLDER]';&amp;netsh delete helper ebpfnetsh.dll&quot;" Before="eBPF_netsh_helper_uninstall" Sequence="execute"/>
		<CustomAction Id="eBPF_netsh_helper_uninstall" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no"/>
		<SetProperty Id="eBPF_netsh_helper_uninstall_rollback" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass &quot;cd '[INSTALLFOLDER]';&amp;netsh delete helper ebpfnetsh.dll&quot;" Before="eBPF_netsh_helper_uninstall_rollback" Sequence="execute"/>
		<CustomAction Id="eBPF_netsh_helper_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no"/>

		<!--Install/Uninstall the eBPF Service -->
		<ComponentGroup Id="eBPF_Service" Directory="dir_JIT">
			<Component Id="EBPFSVC.PDB" DiskId="1" Guid="{D1935DF0-2FC7-42F5-81E5-19AF88D6244B}">
				<File Id="EBPFSVC.PDB" Name="EbpfSvc.pdb" Source="$(var.ebpfsvc.TargetDir)ebpfsvc.pdb" />
			</Component>
			<Component Id="eBPF_Service" Guid="{25F4F9A3-78EB-4598-9982-98FB65377A51}">
				<File Id="EBPFSVC.EXE" Source="$(var.ebpfsvc.TargetPath)" KeyPath="yes" />
				<ServiceControl Id="eBPFSvc_Start" Name="eBPFSvc"
								Start="install"
								Wait="no" />
				<ServiceControl Id="eBPFSvc_Stop" Name="eBPFSvc"
								Stop="both"
								Wait="yes" />
			</Component>
		</ComponentGroup>

		<!--Install/Uninstall the eBPFCore Driver-->
		<!--A kernel driver service is not currently supported by the Windows Installer (Wix v3 - https://wixtoolset.org/docs/v3/xsd/wix/serviceinstall/).-->
		<ComponentGroup Id="eBPFCore_Driver" Directory="dir_drivers">
			<Component Id="eBPFCore.inf" Guid="{3D31A9C8-8BB0-48A2-94BD-CBA734438E0C}">
				<File Id="eBPFCore.inf" Name="eBPFCore.inf" Source="$(var.EbpfCore.TargetDir)eBPFCore.inf" KeyPath="yes"/>
			</Component>
			<Component Id="eBPFCore.sys" Guid="{5A6F4BA2-7FCB-48F7-BC6A-52C204E4A91A}">
				<File Id="eBPFCore.sys" Name="eBPFCore.sys" Source="$(var.EbpfCore.TargetPath)" KeyPath="yes" />
			</Component>
			<Component Id="eBPFCore.pdb" Guid="{DDE1BBD0-F440-4D54-97D0-D10DB511BACB}">
				<File Id="eBPFCore.pdb" Name="eBPFCore.pdb" Source="$(var.EbpfCore.TargetDir)eBPFCore.pdb" KeyPath="yes" />
			</Component>
		</ComponentGroup>
		<SetProperty Id="Force_eBPFSvc_stop" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; { $service = Get-Service -Name eBPFSvc -ErrorAction SilentlyContinue; if ($null -ne $service -and $service.Status -ne 'Stopped') { Stop-Service -Name eBPFSvc -ErrorAction Stop; for ($i = 0; $i -lt 30 -and (Get-Service -Name eBPFSvc).Status -ne 'Stopped'; $i++) { Start-Sleep -Seconds 1 }; if ((Get-Service -Name eBPFSvc).Status -ne 'Stopped') { throw 'eBPFSvc did not stop' } } }&quot;" Before="Force_eBPFSvc_stop" Sequence="execute"/>
		<CustomAction Id="Force_eBPFSvc_stop" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPFSvc_stop_rollback" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; { $service = Get-Service -Name eBPFSvc -ErrorAction SilentlyContinue; if ($null -ne $service -and $service.Status -ne 'Stopped') { Stop-Service -Name eBPFSvc -ErrorAction SilentlyContinue } }&quot;" Before="Force_eBPFSvc_stop_rollback" Sequence="execute"/>
		<CustomAction Id="Force_eBPFSvc_stop_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>
		<SetProperty Id="Force_NetEbpfExt_Driver_stop" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; { $service = Get-Service -Name NetEbpfExt -ErrorAction SilentlyContinue; if ($null -ne $service -and $service.Status -ne 'Stopped') { Stop-Service -Name NetEbpfExt -ErrorAction Stop; for ($i = 0; $i -lt 30 -and (Get-Service -Name NetEbpfExt).Status -ne 'Stopped'; $i++) { Start-Sleep -Seconds 1 }; if ((Get-Service -Name NetEbpfExt).Status -ne 'Stopped') { throw 'NetEbpfExt did not stop' } } }&quot;" Before="Force_NetEbpfExt_Driver_stop" Sequence="execute"/>
		<CustomAction Id="Force_NetEbpfExt_Driver_stop" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPFCore_Driver_stop" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;&amp; { $service = Get-Service -Name eBPFCore -ErrorAction Stop; if ($service.Status -ne 'Stopped') { Stop-Service -Name eBPFCore -ErrorAction Stop; for ($i = 0; $i -lt 30 -and (Get-Service -Name eBPFCore).Status -ne 'Stopped'; $i++) { Start-Sleep -Seconds 1 }; if ((Get-Service -Name eBPFCore).Status -ne 'Stopped') { throw 'eBPFCore did not stop' } } }&quot;" Before="Force_eBPFCore_Driver_stop" Sequence="execute"/>
		<CustomAction Id="Force_eBPFCore_Driver_stop" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_binaries_hardlink" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action Install" Before="Force_eBPF_binaries_hardlink" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_binaries_hardlink" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_binaries_restore" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action Rollback" Before="Force_eBPF_binaries_restore" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_binaries_restore" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_binaries_cleanup" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action Commit" Before="Force_eBPF_binaries_cleanup" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_binaries_cleanup" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_binaries_uninstall_restore" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RestoreLinks" Before="Force_eBPF_binaries_uninstall_restore" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_binaries_uninstall_restore" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_binaries_uninstall_rollback" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackRestoreLinks" Before="Force_eBPF_binaries_uninstall_rollback" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_binaries_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_backup" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action BackupServices -OwnerProductCode &quot;[ProductCode]&quot; -OwnerUpgradeCode &quot;$(var.UpgradeCode)&quot;" Before="Force_eBPF_services_backup" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_backup" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_rollback" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackServices" Before="Force_eBPF_services_rollback" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_commit" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action CommitServices" Before="Force_eBPF_services_commit" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_commit" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_uninstall_remove" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RemoveServices" Before="Force_eBPF_services_uninstall_remove" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_uninstall_remove" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_uninstall_prepare" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action PrepareRestoreServices" Before="Force_eBPF_services_uninstall_prepare" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_uninstall_prepare" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_uninstall_restore" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RestoreServices" Before="Force_eBPF_services_uninstall_restore" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_uninstall_restore" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_uninstall_rollback" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action RollbackRestoreServices" Before="Force_eBPF_services_uninstall_rollback" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPF_services_uninstall_commit" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath '[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-services.original.json','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-services.json' -Force -ErrorAction SilentlyContinue; Remove-Item -LiteralPath '[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\ebpf-services.uninstall-rollback.json' -Force -ErrorAction SilentlyContinue; Remove-Item -LiteralPath '[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\eBPFCore.original.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\NetEbpfExt.original.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\eBPFSvc.original.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\eBPFCore.uninstall-rollback.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\NetEbpfExt.uninstall-rollback.reg','[CommonAppDataFolder]eBPF-for-Windows\MsiBackup\eBPFSvc.uninstall-rollback.reg' -Force -ErrorAction SilentlyContinue&quot;" Before="Force_eBPF_services_uninstall_commit" Sequence="execute"/>
		<CustomAction Id="Force_eBPF_services_uninstall_commit" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="commit" Return="ignore" Impersonate="no"/>
		<SetProperty Id="eBPFCore_Driver_install" Value='"sc.exe" create eBPFCore type=kernel start=auto binpath="[#eBPFCore.sys]"' Before="eBPFCore_Driver_install" Sequence="execute"/>
		<CustomAction Id="eBPFCore_Driver_install" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_eBPFCore_Driver_configure" Value='"sc.exe" config eBPFCore type=kernel start=auto binpath="[System64Folder]drivers\eBPFCore.sys"' Before="Force_eBPFCore_Driver_configure" Sequence="execute"/>
		<CustomAction Id="Force_eBPFCore_Driver_configure" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<Property Id="eBPFCore_Driver_start" Value='"net.exe" start eBPFCore' />
		<CustomAction Id="eBPFCore_Driver_start" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<Property Id="eBPFCore_Driver_stop" Value='"net.exe" stop eBPFCore' />
		<CustomAction Id="eBPFCore_Driver_stop" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no"/>
		<CustomAction Id="eBPFCore_Driver_uninstall_flush" Directory="ProgramFiles64Folder" ExeCommand ='"sc.exe" query eBPFCore' Execute ="immediate" Return ="asyncNoWait"/>
		<Property Id="eBPFCore_Driver_stop_rollback" Value='"net.exe" stop eBPFCore' />
		<CustomAction Id="eBPFCore_Driver_stop_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>
		<Property Id="eBPFCore_Driver_uninstall_rollback" Value='"sc.exe" delete eBPFCore' />
		<CustomAction Id="eBPFCore_Driver_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>

		<!--Install/Uninstall the NetEbpfExt Driver-->
		<!--A kernel driver service is not currently supported by the Windows Installer (Wix v3 - https://wixtoolset.org/docs/v3/xsd/wix/serviceinstall/).-->
		<ComponentGroup Id="NetEbpfExt_Driver" Directory="dir_drivers">
			<Component Id="NetEbpfExt.inf" Guid="{F1E813EE-665E-488C-84AA-0F47011C12F0}">
				<File Id="NetEbpfExt.inf" Name="NetEbpfExt.inf" Source="$(var.netebpfext.TargetDir)NetEbpfExt.inf" KeyPath="yes" />
			</Component>
			<Component Id="NetEbpfExt.sys" Guid="{3ADAA711-7F62-472A-A60D-589D543ED507}">
				<File Id="NetEbpfExt.sys" Name="NetEbpfExt.sys" Source="$(var.netebpfext.TargetPath)" KeyPath="yes" />
			</Component>
			<Component Id="NetEbpfExt.pdb" Guid="{3B35751C-693A-47C0-A258-97741D8B72CC}">
				<File Id="NetEbpfExt.pdb" Name="NetEbpfExt.pdb" Source="$(var.netebpfext.TargetDir)NetEbpfExt.pdb" KeyPath="yes" />
			</Component>
		</ComponentGroup>
		<SetProperty Id="NetEbpfExt_Driver_install" Value='"sc.exe" create NetEbpfExt type=kernel start=auto binpath="[#NetEbpfExt.sys]"' Before="NetEbpfExt_Driver_install" Sequence="execute"/>
		<CustomAction Id="NetEbpfExt_Driver_install" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_NetEbpfExt_Driver_install" Value='"sc.exe" create NetEbpfExt type=kernel start=auto binpath="[System64Folder]drivers\NetEbpfExt.sys"' Before="Force_NetEbpfExt_Driver_install" Sequence="execute"/>
		<CustomAction Id="Force_NetEbpfExt_Driver_install" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<SetProperty Id="Force_NetEbpfExt_Driver_configure" Value='"sc.exe" config NetEbpfExt type=kernel start=auto binpath="[System64Folder]drivers\NetEbpfExt.sys"' Before="Force_NetEbpfExt_Driver_configure" Sequence="execute"/>
		<CustomAction Id="Force_NetEbpfExt_Driver_configure" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<Property Id="NetEbpfExt_Driver_start" Value='"net.exe" start NetEbpfExt' />
		<CustomAction Id="NetEbpfExt_Driver_start" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<Property Id="NetEbpfExt_Driver_stop" Value='"net.exe" stop NetEbpfExt' />
		<CustomAction Id="NetEbpfExt_Driver_stop" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="ignore" Impersonate="no"/>
		<Property Id="NetEbpfExt_Driver_stop_rollback" Value='"net.exe" stop NetEbpfExt' />
		<CustomAction Id="NetEbpfExt_Driver_stop_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>
		<Property Id="NetEbpfExt_Driver_uninstall_rollback" Value='"sc.exe" delete NetEbpfExt' />
		<CustomAction Id="NetEbpfExt_Driver_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>
		<SetProperty Id="Force_eBPFSvc_configure" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action InstallEbpfSvc" Before="SetForce_eBPFSvc_configure_canonical" Sequence="execute"/>
		<SetProperty Id="Force_eBPFSvc_configure" Action="SetForce_eBPFSvc_configure_canonical" Value="&quot;[WindowsFolder]System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FORCE_EBPF_STACK.PS1]&quot; -Action InstallEbpfSvc -UseCanonicalServicePath" Before="Force_eBPFSvc_configure" Sequence="execute">NOT Installed AND EXISTING_EBPFCORE AND FORCE = "1"</SetProperty>
		<CustomAction Id="Force_eBPFSvc_configure" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="deferred" Return="check" Impersonate="no"/>
		<Property Id="eBPFSvc_uninstall_rollback" Value='"sc.exe" delete eBPFSvc' />
		<CustomAction Id="eBPFSvc_uninstall_rollback" BinaryKey="WixCA" DllEntry="WixQuietExec64" Execute="rollback" Return="ignore" Impersonate="no"/>
	</Fragment>
</Wix>
